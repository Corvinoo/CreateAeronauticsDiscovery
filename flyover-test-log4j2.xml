<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} [%t] %-5level %logger{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="me.corvino.aeronauticsdiscovery" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="net.neoforged.fml.testing" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Logger name="net.minecraft.gametest.framework" level="info" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>
        <Root level="error">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
